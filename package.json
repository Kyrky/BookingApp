{
  "name": "BookingApp",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:test": "turbo run dev test --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:all": "turbo run test --filter=@repo/all-tests",
    "test:e2e": "turbo run test --filter=@repo/playwright",
    "test:e2e:ui": "turbo run test:ui --filter=@repo/playwright",
    "test:e2e:debug": "turbo run test:debug --filter=@repo/playwright"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.16",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2",
    "vitest": "^4.0.16"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
